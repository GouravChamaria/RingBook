generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id       Int      @id @default(autoincrement())
  email    String   @unique
  password String
}

model PageContent {
  id        Int      @id @default(autoincrement())
  pageKey   String   @unique // "privacy", "terms", "contact"
  title     String
  sections  String   // JSON stringified array of sections
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactInfo {
  id           Int      @id @default(autoincrement())
  email        String
  phone        String
  address      String
  supportHours String
  updatedAt    DateTime @updatedAt
}
